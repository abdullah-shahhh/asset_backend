# --- App ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api
APP_NAME=Urban Asset Management Platform
CLIENT_URL=http://localhost:5173
# Comma-separated origins allowed by CORS (client-panel + superadmin-panel). * = any.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# --- Main DB (control-plane: orgs, platform users, RBAC, audit log, directory) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=uamp_main
DB_DIALECT=postgres
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# --- Tenant DB (one Postgres database per organization) ---
# The role below needs CREATEDB privilege so the app can provision org databases.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_PREFIX=uamp_org_

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Super-admin bootstrap (used by scripts/seed-main.js) ---
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=admin@uamp.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# --- Demo org bootstrap (used by scripts/seed-demo-org.js) ---
SEED_DEMO_ORG_NAME=Demo City Utilities
SEED_DEMO_ORG_SLUG=demo-city
SEED_DEMO_ADMIN_EMAIL=admin@demo-city.local
SEED_DEMO_ADMIN_PASSWORD=ChangeMe123!

# --- Uploads (media attachments) ---
UPLOAD_DIR=src/uploads
MAX_UPLOAD_SIZE_MB=15

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Redis (optional in Phase 1 — reserved for future async jobs) ---
REDIS_URL=redis://localhost:6379
